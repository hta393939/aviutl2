#include <winresrc.h>
#include "jpeghdr_input.h"

CONFIG DIALOG 0, 0, 128, 96
STYLE DS_MODALFRAME | DS_3DLOOK | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "連番JPEG-HDR入力の設定"
FONT 9, "メイリオ"
{
 CONTROL "OK", IDOK, "BUTTON", BS_PUSHBUTTON | BS_CENTER | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 8, 76, 52, 16
 CONTROL "Cancel", IDCANCEL, "BUTTON", BS_PUSHBUTTON | BS_CENTER | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 68, 76, 52, 16
 CONTROL "", IDC_EDIT0, "edit", ES_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP, 8, 20, 64, 16
 CONTROL "", IDC_EDIT1, "edit", ES_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP, 8, 40, 64, 16
 CONTROL "RGBにAを掛ける", IDC_CHECK1, "Button", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE|WS_TABSTOP, 8,56, 112,16
}
