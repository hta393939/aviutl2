#include <winresrc.h>
#include "apng_output.h"

CONFIG DIALOG 0, 0, 128, 96
STYLE DS_MODALFRAME | DS_3DLOOK | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "APNG出力の設定"
FONT 9, "メイリオ"
{

 CONTROL "OK", IDOK, "BUTTON", BS_PUSHBUTTON | BS_CENTER | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 8, 72, 52, 16
 CONTROL "Cancel", IDCANCEL, "BUTTON", BS_PUSHBUTTON | BS_CENTER | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 68, 72, 52, 16
 LTEXT "繰り返し回数\n(0 を指定すると無限ループ)", IDC_STATIC, 8, 4, 112,16 
 EDITTEXT IDC_EDIT0, 8, 24, 60,16, ES_NUMBER

 CONTROL "RGBをAで割る", IDC_CHECK1, "Button", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 8,48, 112,16
}
