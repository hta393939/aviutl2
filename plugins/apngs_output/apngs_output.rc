#include <winresrc.h>
#include "apngs_output.h"

CONFIG DIALOG 0, 0, 128, 96
STYLE DS_MODALFRAME | DS_3DLOOK | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "連番PNG出力の設定"
FONT 9, "ＭＳ Ｐゴシック"
{
 CONTROL "OK", IDOK, "BUTTON", BS_PUSHBUTTON | BS_CENTER | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 8, 56, 52, 16
 CONTROL "ｷｬﾝｾﾙ", IDCANCEL, "BUTTON", BS_PUSHBUTTON | BS_CENTER | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 68, 56, 52, 16
 CONTROL "", IDC_EDIT0, "edit", ES_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP, 68, 32, 52, 16
 CONTROL "右半分を不透明度として扱う", IDC_CHECK1, "Button", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE, 8,80, 112,16
}
